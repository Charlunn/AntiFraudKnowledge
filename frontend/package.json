{
  "name": "chengyuan-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --require ./scripts/polyfill-crypto.cjs ./node_modules/@nuxt/cli/bin/nuxi.mjs build",
    "dev": "node --require ./scripts/polyfill-crypto.cjs ./node_modules/@nuxt/cli/bin/nuxi.mjs dev",
    "generate": "node --require ./scripts/polyfill-crypto.cjs ./node_modules/@nuxt/cli/bin/nuxi.mjs generate",
    "preview": "node --require ./scripts/polyfill-crypto.cjs ./node_modules/@nuxt/cli/bin/nuxi.mjs preview",
    "postinstall": "nuxt prepare",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "axios": "^1.8.4",
    "echarts": "^5.6.0",
    "nuxt": "^3.15.4",
    "nuxt-icon": "^0.6.10",
    "vue-echarts": "^7.0.3"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.10.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@playwright/test": "^1.53.0"
  }
}
