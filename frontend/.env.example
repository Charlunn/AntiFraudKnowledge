# OAuth配置示例文件
# 复制此文件为 .env 并填入真实的应用ID

# QQ互联应用ID
NUXT_QQ_APP_ID=your_qq_app_id_here

# 微信开放平台应用ID
NUXT_WECHAT_APP_ID=your_wechat_app_id_here

# 抖音开放平台应用ID
NUXT_DOUYIN_APP_ID=your_douyin_app_id_here

# 支付宝开放平台应用ID
NUXT_ALIPAY_APP_ID=your_alipay_app_id_here

# API基础URL（可选）
NUXT_PUBLIC_API_BASE=/api

# OAuth第三方登录功能开关 (true=启用, false=禁用)
ENABLE_OAUTH_LOGIN=false